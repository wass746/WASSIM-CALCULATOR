<Window x:Class="WASSIM_CALCULATOR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WASSIM_CALCULATOR"
        mc:Ignorable="d"
        Title="Calculatrice" Height="740" Width="400"
        MinHeight="640" MinWidth="340"
        Background="#0F1015"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Couleurs -->
        <SolidColorBrush x:Key="PanelBrush"    Color="#1A1B22"/>
        <SolidColorBrush x:Key="NumberBrush"   Color="#23252E"/>
        <SolidColorBrush x:Key="OperatorBrush" Color="#2B2E45"/>
        <SolidColorBrush x:Key="AccentText"    Color="#E89BCA"/>
        <SolidColorBrush x:Key="ClearBrush"    Color="#3A2229"/>
        <SolidColorBrush x:Key="ClearText"     Color="#FF7B8A"/>

        <LinearGradientBrush x:Key="EqualBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6C7BFF" Offset="0"/>
            <GradientStop Color="#9B6CFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Style de base : bouton arrondi avec survol et effet d'appui -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource NumberBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border x:Name="Overlay" CornerRadius="20"
                                        Background="White" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.09"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.16"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumberButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

        <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource OperatorBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource ClearBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ClearText}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="EqualButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource EqualBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Boutons de fonctions : sin, cos, tan, racine carrée -->
        <Style x:Key="FunctionButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Affichage -->
        <Style x:Key="DisplayStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="LightGreen"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="46"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Écran -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Margin="6,6,6,12"
                Background="{StaticResource PanelBrush}" CornerRadius="24">
            <TextBox Name="TB_Display" Style="{StaticResource DisplayStyle}"/>
        </Border>

        <!-- Fonctions -->
        <Button Grid.Row="1" Grid.Column="0" Name="BTN_Sin" Content="sin" Click="BTN_Sin_Click" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="1" Name="BTN_Cos" Content="cos" Click="BTN_Cos_Click" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="2" Name="BTN_Tan" Content="tan" Click="BTN_Tan_Click" Style="{StaticResource FunctionButton}"/>
        <Button Grid.Row="1" Grid.Column="3" Name="BTN_Racine" Content="√" Click="BTN_Racine_Click" Style="{StaticResource FunctionButton}"/>

        <!-- Ligne 1 -->
        <Button Grid.Row="2" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="2" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="2" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="2" Grid.Column="3" Name="BTN_Plus" Content="+" Click="BTN_Plus_Click" Style="{StaticResource OperatorButton}"/>

        <!-- Ligne 2 -->
        <Button Grid.Row="3" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="3" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="3" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="3" Grid.Column="3" Name="BTN_Moin" Content="−" Click="BTN_Moins_Click" Style="{StaticResource OperatorButton}"/>

        <!-- Ligne 3 -->
        <Button Grid.Row="4" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="4" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="4" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="4" Grid.Column="3" Name="BTN_Multiplication" Content="×" Click="BTN_Multiplication_Click" Style="{StaticResource OperatorButton}"/>

        <!-- Ligne 4 -->
        <Button Grid.Row="5" Grid.Column="0" Name="BTN_0" Content="0" Click="BTN_0_Click" Style="{StaticResource NumberButton}"/>
        <Button Grid.Row="5" Grid.Column="1" Name="BTN_C" Content="C" Click="BTN_C_Click" Style="{StaticResource ClearButton}"/>
        <Button Grid.Row="5" Grid.Column="2" Name="BTN_Division" Content="÷" Click="BTN_Division_Click" Style="{StaticResource OperatorButton}"/>
        <Button Grid.Row="5" Grid.Column="3" Name="BTN_Egal" Content="=" Click="BTN_Egal_Click" Style="{StaticResource EqualButton}"/>
    </Grid>
</Window>
